# ============================================
# GymOS - Supabase Configuration
# ============================================

# 🔗 DATABASE CONFIGURATION (Supabase PostgreSQL)
# Get this from: Supabase Dashboard → Settings → Database → Connection string → URI
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres
#
# Steps:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings → Database
# 4. Copy the URI from Connection string section
# 5. Replace [PASSWORD] with your database password
DATABASE_URL="postgresql://postgres:YourDatabasePassword123@db.abcdefghijklmnop.supabase.co:5432/postgres"

# 🔐 JWT CONFIGURATION
# This is for your custom JWT authentication (not using Supabase Auth for now)
# Generate a strong secret key - use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secure-random-jwt-secret-key-32-characters-minimum"
JWT_EXPIRATION=3600

# 📱 APPLICATION CONFIGURATION
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# 📊 RETENTION CONFIGURATION
RETENTION_AT_RISK_DAYS=7
RETENTION_INACTIVE_DAYS=15

# ============================================
# Optional: Supabase Advanced Features
# ============================================
# Only needed if you want to use Supabase Auth or Storage
# Get these from: Supabase Dashboard → Settings → API

# Project URL (from Supabase)
# Example: https://abcdefghijklmnop.supabase.co
SUPABASE_URL="https://your-project-id.supabase.co"

# Anon Key (Public - safe to expose in frontend)
# Copy from Settings → API → anon public
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Service Role Key (Secret - NEVER expose!)
# Copy from Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
