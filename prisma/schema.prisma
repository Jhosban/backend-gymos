generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Member {
  id                     String       @id @default(cuid())
  name                   String
  email                  String       @unique
  phone                  String
  birthDate              DateTime?
  gender                 String?
  goal                   String
  experienceLevel        String
  membershipType         String
  joinedAt               DateTime     @default(now())
  membershipEnd          DateTime?
  monthlyPrice           Float        @default(0)
  membershipStatus       String       @default("ACTIVO")
  status                 String       @default("INACTIVE")
  lastCheckIn            DateTime?
  checkInsLast30Days     Int          @default(0)
  averageCheckInsPerWeek Float        @default(0)
  preferredSchedule      String?
  churnRiskScore         Int          @default(0)
  churnRiskLevel         String       @default("BAJO")
  acquisitionSource      String?
  assignedTrainer        String?
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  biometricCredentialId  String?      @unique

  attendance Attendance[]

  @@index([status])
  @@index([churnRiskLevel])
  @@index([membershipStatus])
  @@map("members")
}

model Attendance {
  id         String   @id @default(cuid())
  memberId   String
  attendedAt DateTime @default(now())
  duration   Int?
  activities String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([attendedAt])
  @@map("attendance")
}

model Lead {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String
  source          String
  status          String   @default("NUEVO")
  assignedAdvisor String
  productType     String   @default("FITNESS_PRODUCT")
  productDetails  Json?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([productType])
  @@map("leads")
}

model Equipment {
  id                      String              @id @default(cuid())
  name                    String
  category                String
  brand                   String?
  model                   String?
  serialNumber            String?             @unique
  purchaseDate            DateTime
  warrantyEnd             DateTime?
  price                   Float?
  status                  String              @default("NUEVO")
  location                String?
  lastMaintenance         DateTime?
  nextMaintenance         DateTime?
  maintenanceIntervalDays Int
  totalUsageHours         Int?                @default(0)
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  maintenanceHistory MaintenanceRecord[]

  @@index([status])
  @@index([category])
  @@map("equipment")
}

model MaintenanceRecord {
  id            String   @id @default(cuid())
  equipmentId   String
  type          String
  description   String
  technician    String?
  cost          Float?
  scheduledDate DateTime
  completedDate DateTime?
  status        String   @default("PENDIENTE")
  notes         String?
  createdAt     DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([status])
  @@map("maintenance_records")
}

model RetentionAlert {
  id                 String   @id @default(cuid())
  clientId           String
  clientName         String
  type               String
  severity           String
  description        String
  daysSinceLastVisit Int?
  recommendedAction  String
  status             String   @default("PENDIENTE")
  createdAt          DateTime @default(now())
  resolvedAt         DateTime?

  @@index([status])
  @@index([severity])
  @@map("retention_alerts")
}
