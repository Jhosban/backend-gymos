generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("ADMIN")
  gymId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym Gym? @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Gym {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  plan      String   @default("BASIC")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  members    Member[]
  leads      Lead[]
  equipment  Equipment[]
  employees  Employee[]
  gymModules GymModule[]

  @@map("gyms")
}

model Module {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  price       Float    @default(0)
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gymModules GymModule[]

  @@map("modules")
}

model GymModule {
  id          String    @id @default(cuid())
  gymId       String
  moduleId    String
  status      String    @default("TRIAL")
  activatedAt DateTime?
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([gymId, moduleId])
  @@map("gym_modules")
}

model Employee {
  id         String   @id @default(cuid())
  gymId      String
  employeeId String
  fullName   String
  role       String
  schedule   String?
  salary     Float?
  photoUrl   String?
  email      String?
  phone      String?
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("employees")
}

model Member {
  id                     String       @id @default(cuid())
  gymId                  String
  name                   String
  email                  String       @unique
  phone                  String
  birthDate              DateTime?
  gender                 String?
  goal                   String
  experienceLevel        String
  membershipType         String
  joinedAt               DateTime     @default(now())
  membershipEnd          DateTime?
  monthlyPrice           Float        @default(0)
  membershipStatus       String       @default("ACTIVO")
  status                 String       @default("INACTIVE")
  lastCheckIn            DateTime?
  checkInsLast30Days     Int          @default(0)
  averageCheckInsPerWeek Float        @default(0)
  preferredSchedule      String?
  churnRiskScore         Int          @default(0)
  churnRiskLevel         String       @default("BAJO")
  acquisitionSource      String?
  assignedTrainer        String?
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  biometricCredentialId  String?      @unique

  gym        Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  attendance Attendance[]

  @@index([status])
  @@index([churnRiskLevel])
  @@index([membershipStatus])
  @@index([gymId])
  @@map("members")
}

model Attendance {
  id         String   @id @default(cuid())
  memberId   String
  attendedAt DateTime @default(now())
  duration   Int?
  activities String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([attendedAt])
  @@map("attendance")
}

model Lead {
  id              String   @id @default(cuid())
  gymId           String
  name            String
  email           String
  phone           String
  source          String
  status          String   @default("NUEVO")
  assignedAdvisor String
  productType     String?
  productDetails Json?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([source])
  @@index([productType])
  @@index([gymId])
  @@map("leads")
}

model Employee {
  id             String   @id @default(cuid())
  identification String   @unique
  name           String
  position       String
  scheduleDays   String[]
  startTime      String
  endTime        String
  salary         Float
  photoUrl       String?
  email          String   @unique
  phone          String
  status         String   @default("ACTIVO")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([position])
  @@map("employees")
}

model Equipment {
  id                      String              @id @default(cuid())
  gymId                   String
  name                    String
  category                String
  brand                   String?
  model                   String?
  serialNumber            String?             @unique
  purchaseDate            DateTime
  warrantyEnd             DateTime?
  price                   Float?
  status                  String              @default("NUEVO")
  location                String?
  lastMaintenance         DateTime?
  nextMaintenance         DateTime?
  maintenanceIntervalDays Int
  totalUsageHours         Int?                @default(0)
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  gym                 Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  maintenanceHistory MaintenanceRecord[]

  @@index([status])
  @@index([category])
  @@index([gymId])
  @@map("equipment")
}

model MaintenanceRecord {
  id            String    @id @default(cuid())
  equipmentId   String
  type          String
  description   String
  technician    String?
  cost          Float?
  scheduledDate DateTime
  completedDate DateTime?
  status        String    @default("PENDIENTE")
  notes         String?
  createdAt     DateTime  @default(now())
  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([status])
  @@map("maintenance_records")
}

model RetentionAlert {
  id                 String    @id @default(cuid())
  clientId           String
  clientName         String
  type               String
  severity           String
  description        String
  daysSinceLastVisit Int?
  recommendedAction  String
  status             String    @default("PENDIENTE")
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?

  @@index([status])
  @@index([severity])
  @@map("retention_alerts")
}
